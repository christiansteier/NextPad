# NextPad, erzeugt vom YunoHost-Paket. Änderungen über das Konfigurationsfenster, nicht hier.
NEXTPAD_BIND=127.0.0.1:__PORT__
NEXTPAD_DATA=__DATA_DIR__/data
NEXTPAD_API_KEYS_FILE=__DATA_DIR__/secrets/api-keys.txt
NEXTPAD_LTI_FILE=__DATA_DIR__/secrets/lti-platforms.json
NEXTPAD_THEME_DIR=__DATA_DIR__/theme
NEXTPAD_BASE_PATH=__BASE_PATH__
NEXTPAD_PUBLIC_URL=https://__DOMAIN____BASE_PATH__
NEXTPAD_TRUST_PROXY=true
NEXTPAD_TRUSTED_PROXIES=127.0.0.1,::1
NEXTPAD_API_ALLOWED=__API_ALLOWED__
NEXTPAD_FRAME_ANCESTORS="__FRAME_ANCESTORS__"
NEXTPAD_THEME=__THEME__
NEXTPAD_SITE_NAME="__SITE_NAME__"
NEXTPAD_ADMINS="__ADMINS__"
NEXTPAD_ALLOW_FREE_PADS=__FREE_PADS__
NEXTPAD_ADDONS=__ADDONS__
NEXTPAD_FREE_PADS_PER_HOUR=__FREE_PADS_PER_HOUR__
NEXTPAD_RETENTION=__RETENTION__
NEXTPAD_HISTORY_DAYS=__HISTORY_DAYS__
NEXTPAD_SMTP_URL=smtp://127.0.0.1:25
NEXTPAD_MAIL_FROM="NextPad <__APP__@__DOMAIN__>"
NEXTPAD_FOOTER_LINKS="__FOOTER_LINKS__"
NEXTPAD_BACKGROUND_CREDIT="__BACKGROUND_CREDIT__"
NEXTPAD_BACKGROUND_CREDIT_URL=__BACKGROUND_CREDIT_URL__
RUST_LOG=info
