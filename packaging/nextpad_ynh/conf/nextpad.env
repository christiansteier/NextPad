# NextPad, erzeugt vom YunoHost-Paket. Änderungen über das Konfigurationsfenster, nicht hier.
COOPPAD_BIND=127.0.0.1:__PORT__
COOPPAD_DATA=__DATA_DIR__/data
COOPPAD_API_KEYS_FILE=__DATA_DIR__/secrets/api-keys.txt
COOPPAD_LTI_FILE=__DATA_DIR__/secrets/lti-platforms.json
COOPPAD_THEME_DIR=__DATA_DIR__/theme
COOPPAD_BASE_PATH=__BASE_PATH__
COOPPAD_PUBLIC_URL=https://__DOMAIN____BASE_PATH__
COOPPAD_TRUST_PROXY=true
COOPPAD_TRUSTED_PROXIES=127.0.0.1,::1
COOPPAD_API_ALLOWED=__API_ALLOWED__
COOPPAD_FRAME_ANCESTORS="__FRAME_ANCESTORS__"
COOPPAD_THEME=__THEME__
COOPPAD_SITE_NAME="__SITE_NAME__"
COOPPAD_ALLOW_FREE_PADS=__FREE_PADS__
COOPPAD_FREE_PADS_PER_HOUR=__FREE_PADS_PER_HOUR__
COOPPAD_RETENTION=__RETENTION__
COOPPAD_HISTORY_DAYS=__HISTORY_DAYS__
COOPPAD_SMTP_URL=smtp://127.0.0.1:25
COOPPAD_MAIL_FROM="NextPad <__APP__@__DOMAIN__>"
COOPPAD_FOOTER_LINKS="__FOOTER_LINKS__"
COOPPAD_BACKGROUND_CREDIT="__BACKGROUND_CREDIT__"
COOPPAD_BACKGROUND_CREDIT_URL=__BACKGROUND_CREDIT_URL__
RUST_LOG=info
