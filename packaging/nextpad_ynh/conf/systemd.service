[Unit]
Description=NextPad (Etherpad-kompatibler Pad-Server)
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__DATA_DIR__
EnvironmentFile=__INSTALL_DIR__/nextpad.env
ExecStart=__INSTALL_DIR__/nextpad
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0027

# Grenzen: eine Datei je WebSocket-Verbindung, Speicher und CPU begrenzt
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=100%
TasksMax=256

# Abschottung: nur das Datenverzeichnis ist beschreibbar
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATA_DIR__/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
